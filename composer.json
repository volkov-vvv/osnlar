{
    "name": "laravel/laravel",
    "type": "project",
    "description": "The Laravel Framework.",
    "keywords": ["framework", "laravel"],
    "license": "MIT",
    "require": {
        "php": "^8.3",
        "bushlanov-dev/max-bot-api-client-php": "^1.6",
        "defstudio/telegraph": "^1.56",
        "doctrine/dbal": "^3.9",
        "guzzlehttp/guzzle": "^7.0.1",
        "itsjavi/bootstrap-colorpicker": "^3.4",
        "laravel/framework": "^13.0",
        "laravel/sanctum": "^4.0",
        "laravel/tinker": "^3.0",
        "laravel/ui": "^4.0",
        "maatwebsite/excel": "^3.1",
        "phpoffice/phpspreadsheet": "^1.30",
        "spatie/data-transfer-object": "^3.9",
        "spatie/laravel-activitylog": "^4.7",
        "spatie/laravel-cookie-consent": "^3.2",
        "yoomoney/yookassa-sdk-php": "^3.0"
    },
    "require-dev": {
        "barryvdh/laravel-debugbar": "^4.0",
        "spatie/laravel-ignition": "^2.0",
        "fakerphp/faker": "^1.9.1",
        "laravel/sail": "^1.0.1",
        "mockery/mockery": "^1.4.4",
        "nunomaduro/collision": "^8.1",
        "phpunit/phpunit": "^12.0"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/",
            "Database\\Factories\\": "database/factories/",
            "Database\\Seeders\\": "database/seeders/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "post-autoload-dump": [
            "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
            "@php artisan package:discover --ansi"
        ],
        "post-update-cmd": [
            "@php artisan vendor:publish --tag=laravel-assets --ansi --force"
        ],
        "post-root-package-install": [
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\""
        ],
        "post-create-project-cmd": [
            "@php artisan key:generate --ansi"
        ]
    },
    "extra": {
        "laravel": {
            "dont-discover": []
        }
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true,
        "platform": {
            "php": "8.4.99"
        },
        "audit": {
            "ignore": ["laravel/framework"],
            "block-insecure": false
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
